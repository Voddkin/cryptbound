[resource]
script = ExtResource("1_arma")
id = &"pa_de_coveiro"
nome = "Pá de Coveiro"
descricao = "Ferramenta de ofício. Três golpes em sequência; o último é uma pancada que empurra e interrompe. Segure para uma cavada que arremessa tudo ao redor."
sprite = ExtResource("3_sprite")
empunhadura = Vector2(4, 3)
combo = Array[ExtResource("2_golpe")]([SubResource("golpe_varrida"), SubResource("golpe_contra"), SubResource("golpe_pancada")])
pesado = SubResource("golpe_cavada")
carga_pesado = 0.45
tempo_combo = 0.45
