[ext_resource type="Script" path="res://jogo/entidades/inimigos/inimigo_dados.gd" id="1_dados"]

[resource]
script = ExtResource("1_dados")
id = &"lamuriante"
nome = "Lamuriante"
ataque = "Lamúria"
dica = "Enquanto a Lamuriante canta, os Ressequidos ligados a ela pelo fio de luz ficam mais rápidos. Derrube-a primeiro; pilares e paredes bloqueiam a Lamúria."
